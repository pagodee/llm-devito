# Versões usadas no build das imagens. Este é o ÚNICO lugar onde elas aparecem:
# o build.sh lê este arquivo e passa cada valor para as recipes, que o usam
# como {{ NOME }}. Para atualizar o dsh ou o Ollama, mude aqui e reconstrua.
#
# Fixar as versões garante que um build hoje e outro daqui a meses (ou na
# máquina de outra pessoa) produzam a mesma imagem.

# Imagem base do harness: arquivos do Debian 12 com o Node 24 já instalado
NODE_IMAGE=node:24-bookworm-slim

# DeepSeek Harness (pacote npm @deepseek-ai/dsh)
DSH_VERSION=0.2.1-rc.2

# Imagem oficial do Ollama: arquivos do Ubuntu + ollama + bibliotecas CUDA
OLLAMA_IMAGE=ollama/ollama:0.40.13
